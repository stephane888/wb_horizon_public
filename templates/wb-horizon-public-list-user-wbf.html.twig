<div class="container user-list-webform">
	<div class="items">
	{% for form in forms %}
		<div class="item mb-5 d-flex flex-column justify-content-between">
				<h3 class="h4 fw-bold item--title"> {{ form.title }} </h3>				
				<div class="number">{{form.number}}</div>		
				<div class="description">
					<div>{{ form.description|raw }}  </div>
					<a class="btn btn-primary" href="{{form.url}}"> Plus de details </a>
				</div>
		</div>
	{% endfor %}
	</div>
</div>
